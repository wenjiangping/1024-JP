// Go Lita v0.3: state, collection score and constrained route generation.
var (
    Score int
    DifficultyStage int
    Mushrooms int
    Diamonds int
    Rank string
    EndReason string
    Running bool
    Paused bool
    DT float64
    ScrollDX float64
    Speed float64
    RunTime float64
    Distance float64
    PX [5]float64
    PW [5]float64
    PT [5]float64
    LX [5]float64
    LT [5]float64
    LW [5]float64
    HasLedge [5]bool
    // Two slots per chunk: 1 stone, 2 stump, 3 rock pile (solid);
    // 4 fire, 5 bomb (dangerous). OW is the collision half-width.
    OX [10]float64
    OY [10]float64
    OKind [10]int
    OW [10]float64
    OH [10]float64
    ItemX [15]float64
    ItemY [15]float64
    ItemTaken [15]bool
    ItemEnabled [15]bool
    PlayerX float64
    PlayerFeet float64
    BodyX float64
    Facing int
    UILeft bool
    UIRight bool
    UIJump bool
    WantsRetry bool
    WantsPause bool
    epoch int
    previousPattern int
    previousGap bool
    leftPulseFrames int
    rightPulseFrames int
    previousTop float64
    challengeStreak int
    retryHeld bool
    pauseHeld bool
    lastSpeedStep int
)

func updateRank() {
    Rank = "蹦跶小新手"
    if Score >= 30 { Rank = "树影穿梭客" }
    if Score >= 60 { Rank = "灌木飞毛腿" }
    if Score >= 90 { Rank = "林间寻路家" }
    if Score >= 120 { Rank = "风之探险家" }
    if Score >= 150 { Rank = "森林传说" }
    if Score >= 180 { Rank = "森林守护者" }
}
func updateDifficulty() {
    stage := Score / 30
    if stage > 6 { stage = 6 }
    if stage != DifficultyStage {
        DifficultyStage = stage
        println "DIFFICULTY", DifficultyStage, Score
    }
}

func collectItem(i int) {
    if !Running || Paused || ItemTaken[i] || !ItemEnabled[i] { return }
    ItemTaken[i] = true
    if i % 3 == 2 { Diamonds++; Score += 3 } else { Mushrooms++; Score++ }
    updateRank
    updateDifficulty
    broadcast "pickupSound"
    println "HARVEST", Score, Mushrooms, Diamonds
}
func finishRun(reason string) {
    if !Running { return }
    Running = false
    EndReason = reason
    broadcast "finished"
    println "FINISH", reason, Score, Mushrooms, Diamonds, RunTime, BodyX, PlayerFeet
}
func obstacle(k int, kind int, x float64, y float64) {
    OKind[k] = kind
    OX[k] = x
    OY[k] = y
    OW[k] = 20
    OH[k] = 19
    if kind == 2 { OW[k] = 17; OH[k] = 29 }
    if kind == 3 { OW[k] = 22; OH[k] = 37 }
    if kind == 4 { OW[k] = 6; OH[k] = 29 }
    if kind == 5 { OW[k] = 13; OH[k] = 31 }
}

func makeChunk(i int, left float64, opening bool) {
    pattern := int(rand(0, 999)) % 10
    if pattern == previousPattern { pattern = (pattern + 1) % 10 }
    progress := Distance + left
    if progress < 1200 && !opening { pattern = 1 }
    if challengeStreak >= 2 { pattern = 0 }
    if opening { pattern = 0 }
    width := rand(290.0, 330.0)
    gap := 0.0
    top := -102.0
    if progress > 1200 { top += float64(int(rand(0, 299)) % 3 - 1) * 8 }
    if pattern == 7 && progress > 1400 { top = -74 }
    if pattern == 4 && progress > 1600 && !previousGap {
        gap = rand(36.0, 48.0)
        top = previousTop
        // Leave the takeoff and landing clear around every gap.
        for j := 0; j < 10; j++ {
            if OX[j] > left - 140 && OX[j] < left + 2 { OKind[j] = 0 }
        }
    } else if pattern == 4 { pattern = 0 }
    PX[i] = left + gap + width / 2
    PW[i] = width
    PT[i] = top
    HasLedge[i] = !opening && (pattern == 2 || pattern == 9) && gap == 0 && !previousGap
    LX[i] = PX[i] + rand(-14.0, 14.0)
    // Lower route keeps at least 50px headroom; jump apex is about 100px.
    LT[i] = top + 84
    LW[i] = rand(96.0, 112.0)
    a := i * 2
    OKind[a] = 0
    OKind[a+1] = 0
    if !opening && !previousGap && gap == 0 {
        if pattern == 1 { obstacle a, 1 + int(rand(0, 199)) % 2, PX[i], top }
        if pattern == 3 { obstacle a, 3, PX[i], top }
        if pattern == 5 { obstacle a, 2, left + 88, top }
        if pattern == 5 && progress > 1100 { obstacle a+1, 4, left + width - 65, top }
        if pattern == 6 && progress > 1100 { obstacle a, 5, PX[i], top }
        if pattern == 7 { obstacle a, 1, PX[i] + 18, top }
        if pattern == 8 {
            obstacle a, 1, left + 85, top
            if progress > 1100 { obstacle a+1, 2, left + width - 65, top }
        }
        if pattern == 9 && progress > 1100 { obstacle a, 4, PX[i], top }
        // Each 30-point stage adds 10% extra obstacle opportunity. Keep a
        // generous horizontal gap and use danger only after stage 3.
        extraRoll := int(rand(0, 999))
        extraChance := DifficultyStage * 100
        if DifficultyStage > 0 && extraRoll < extraChance && OKind[a+1] == 0 {
            extraKind := 1 + int(rand(0, 299)) % 3
            if DifficultyStage >= 3 && extraRoll % 3 == 0 { extraKind = 4 }
            extraX := PX[i] + 82
            if extraX > left + width/2 - 44 { extraX = PX[i] - 82 }
            obstacle a+1, extraKind, extraX, top
        }
    }
    for j := 0; j < 3; j++ {
        k := i * 3 + j
        ItemTaken[k] = false
        ItemEnabled[k] = true
        ItemX[k] = PX[i] - width/2 + 30
        ItemY[k] = top + 13
        if j == 1 { ItemX[k] = PX[i] + width/2 - 28 }
        if j == 2 {
            ItemX[k] = PX[i]
            ItemY[k] = top + 65
            ItemEnabled[k] = !opening || int(rand(0, 199)) % 2 == 0
            if HasLedge[i] { ItemX[k] = LX[i]; ItemY[k] = LT[i] + 18 }
        }
    }
    if pattern == 0 { challengeStreak = 0 } else { challengeStreak++ }
    previousPattern = pattern
    previousGap = gap > 0
    previousTop = top
    if !opening { println "CHUNK", i, pattern, gap, width, top, OKind[a], OKind[a+1] }
}
func resetRun() {
    broadcastAndWait "clear"
    stopAllSounds
    epoch++
    Score = 0
    Mushrooms = 0
    Diamonds = 0
    RunTime = 0
    Distance = 0
    Speed = 58
    DifficultyStage = -1
    updateDifficulty
    Running = true
    Paused = false
    EndReason = ""
    WantsRetry = false
    WantsPause = false
    leftPulseFrames = 0
    rightPulseFrames = 0
    UILeft = false
    UIRight = false
    UIJump = false
    lastSpeedStep = -1
    previousGap = false
    previousPattern = -1
    previousTop = -102
    challengeStreak = 0
    updateRank
    left := -300.0
    for i := 0; i < 5; i++ {
        makeChunk i, left, i < 3
        left = PX[i] + PW[i] / 2
    }
    broadcastAndWait "setup"
    broadcastAndWait "render"
    Lita.setLayer Front
    println "START", epoch
}
onClick => {
    if mouseY > -122 { broadcast "requestJump" } else { broadcast "pointerTap" }
}
onKey KeyLeft, => { leftPulseFrames = 12 }
onKey KeyA, => { leftPulseFrames = 12 }
onKey KeyRight, => { rightPulseFrames = 12 }
onKey KeyD, => { rightPulseFrames = 12 }
onKey KeyR, => { WantsRetry = true }
onKey KeyP, => { WantsPause = true }
onStart => {
    setVolume 25
    resetTimer
    resetRun
    lastTime := timer
    forever => {
        now := timer
        DT = now - lastTime
        lastTime = now
        if DT > 0.04 { DT = 0.04 }
        broadcastAndWait "input"
        retryDown := keyPressed(KeyR)
        pauseDown := keyPressed(KeyP)
        if retryDown && !retryHeld { WantsRetry = true }
        if pauseDown && !pauseHeld { WantsPause = true }
        if WantsRetry { resetRun }
        if WantsPause && Running {
            Paused = !Paused
            WantsPause = false
            broadcastAndWait "pauseChanged"
            println "PAUSE", Paused, Score, PlayerX, PlayerFeet, RunTime
        }
        retryHeld = retryDown
        pauseHeld = pauseDown
        if Running && !Paused {
            RunTime += DT
            Speed = 58 * (1 + float64(DifficultyStage) * 0.10)
            if Speed > 92.8 { Speed = 92.8 }
            if DifficultyStage != lastSpeedStep {
                lastSpeedStep = DifficultyStage
                println "PACE", DifficultyStage, Speed, Score
            }
            ScrollDX = Speed * DT
            Distance += ScrollDX
            for i := 0; i < 5; i++ { PX[i] -= ScrollDX; LX[i] -= ScrollDX }
            for i := 0; i < 10; i++ { OX[i] -= ScrollDX }
            for i := 0; i < 15; i++ { ItemX[i] -= ScrollDX }
            for i := 0; i < 5; i++ {
                if PX[i] + PW[i] / 2 < -305 {
                    right := -305.0
                    for j := 0; j < 5; j++ {
                        if PX[j] + PW[j] / 2 > right { right = PX[j] + PW[j] / 2 }
                    }
                    makeChunk i, right, false
                }
            }
            broadcastAndWait "physics"
            // Resolve danger before pickup; no score on the ending frame.
            broadcastAndWait "danger"
            broadcastAndWait "render"
        }
        Lita.setLayer Front
        wait 0.016
    }
}
