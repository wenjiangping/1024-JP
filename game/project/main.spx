// Go Lita v0.2: state, constrained chunk generation and collection-only score.
var (
    Score int
    Mushrooms int
    Diamonds int
    Rank string
    Hint string
    Running bool
    Paused bool
    DT float64
    Speed float64
    RunTime float64
    Distance float64
    PX [5]float64
    PW [5]float64
    PT [5]float64
    LX [5]float64
    LT [5]float64
    LW [5]float64
    HasLedge [5]bool
    HX [5]float64
    HY [5]float64
    HazardKind [5]int
    ItemX [15]float64
    ItemY [15]float64
    ItemTaken [15]bool
    ItemEnabled [15]bool
    PlayerX float64
    PlayerFeet float64
    BodyX float64
    Facing int
    UILeft bool
    UIRight bool
    UIJump bool
    WantsRetry bool
    WantsPause bool
    epoch int
    previousPattern int
    previousGap bool
    previousTop float64
    feedbackUntil float64
    retryHeld bool
    pauseHeld bool
    lastSpeedStep int
)

func updateRank() {
    Rank = "蹦跶小新手"
    if Score >= 5 { Rank = "树影穿梭客" }
    if Score >= 12 { Rank = "灌木飞毛腿" }
    if Score >= 24 { Rank = "林间寻路家" }
    if Score >= 40 { Rank = "风之探险家" }
    if Score >= 60 { Rank = "森林传说" }
}

func collectItem(i int) {
    if !Running || Paused || ItemTaken[i] || !ItemEnabled[i] { return }
    ItemTaken[i] = true
    oldRank := Rank
    if i % 3 == 2 {
        Diamonds++
        Score += 3
        Hint = "水晶 +3 · 闪亮的收获！"
    } else {
        Mushrooms++
        Score++
        Hint = "蘑菇 +1 · 收进小背包！"
    }
    updateRank
    if oldRank != Rank { Hint = "新称号：" + Rank }
    feedbackUntil = RunTime + 1.5
    println "HARVEST", Score, Mushrooms, Diamonds
}

func finishRun(reason string) {
    if !Running { return }
    Running = false
    Hint = reason + " · 按 R 重试"
    broadcast "finished"
    println "FINISH", reason, Score, Mushrooms, Diamonds, RunTime
}

// Each slot is one constrained chunk. Obstacles never occupy gap landings.
func makeChunk(i int, left float64, opening bool) {
    pattern := int(rand(0, 599)) % 6
    if pattern == previousPattern { pattern = (pattern + 1) % 6 }
    if opening { pattern = 0 }
    progress := Distance + left
    gap := 0.0
    width := rand(230.0, 280.0)
    top := -102.0
    if !opening { top = -102 + float64(int(rand(0, 299)) % 3 - 1) * 8 }
    if progress < 1300 { top = -102 }
    if pattern == 4 && progress > 1650 && !previousGap {
        gap = rand(36.0, 48.0)
        top = previousTop
        // The previous landing/takeoff area is always clear.
        for j := 0; j < 5; j++ {
            if PX[j] + PW[j] / 2 > left - 2 && PX[j] + PW[j] / 2 < left + 2 { HazardKind[j] = 0 }
        }
    }
    PX[i] = left + gap + width / 2
    PW[i] = width
    PT[i] = top
    HasLedge[i] = !opening && (pattern == 2 || pattern == 5) && gap == 0
    LX[i] = PX[i] + rand(-18.0, 18.0)
    LT[i] = top + rand(42.0, 56.0)
    LW[i] = rand(104.0, 130.0)
    HX[i] = PX[i] + rand(-12.0, 12.0)
    HY[i] = top
    HazardKind[i] = 0
    if !opening && progress > 850 && pattern == 1 && !previousGap {
        HazardKind[i] = 1 + int(rand(0, 299)) % 3
    }
    for j := 0; j < 3; j++ {
        k := i * 3 + j
        ItemTaken[k] = false
        ItemEnabled[k] = true
        ItemX[k] = PX[i] - 55 + float64(j) * 55
        ItemY[k] = top + 12
        if j == 2 {
            ItemEnabled[k] = HasLedge[i] || pattern == 3 || int(rand(0, 399)) % 4 == 0
            ItemY[k] = top + 72
            if HasLedge[i] {
                ItemX[k] = LX[i]
                ItemY[k] = LT[i] + 21
            }
        }
        if HazardKind[i] > 0 && j != 2 {
            if ItemX[k] > HX[i] - 65 && ItemX[k] < HX[i] + 65 { ItemEnabled[k] = false }
        }
    }
    previousPattern = pattern
    previousGap = gap > 0
    previousTop = top
    if !opening { println "CHUNK", i, pattern, gap, width, top, HazardKind[i] }
}

func resetRun() {
    broadcastAndWait "clear"
    stopAllSounds
    epoch++
    Score = 0
    Mushrooms = 0
    Diamonds = 0
    RunTime = 0
    Distance = 0
    Speed = 58
    Running = true
    Paused = false
    WantsRetry = false
    WantsPause = false
    UILeft = false
    UIRight = false
    UIJump = false
    feedbackUntil = 0
    lastSpeedStep = 0
    previousGap = false
    previousPattern = -1
    previousTop = -102
    updateRank
    Hint = "A/D 移动 · 空格跳跃 · P 暂停"
    left := -300.0
    for i := 0; i < 5; i++ {
        makeChunk i, left, i < 3
        left = PX[i] + PW[i] / 2
    }
    broadcastAndWait "setup"
    broadcastAndWait "render"
    Lita.setLayer Front
    println "START", epoch
}

// Forward background taps to the control sprites; each owns its hit box.
onClick => {
    if mouseY > -122 { broadcast "requestJump" } else { broadcast "pointerTap" }
}

onKey KeyR, => { if !retryHeld { WantsRetry = true } }
onKey KeyP, => { if !pauseHeld { WantsPause = true } }

onStart => {
    setVolume 25
    resetTimer
    resetRun
    lastTime := timer
    forever => {
        now := timer
        DT = now - lastTime
        lastTime = now
        if DT > 0.04 { DT = 0.04 }
        broadcastAndWait "input"
        retryDown := keyPressed(KeyR)
        pauseDown := keyPressed(KeyP)
        if retryDown && !retryHeld { WantsRetry = true }
        if pauseDown && !pauseHeld { WantsPause = true }
        if WantsRetry { resetRun }
        if WantsPause && Running {
            Paused = !Paused
            WantsPause = false
            if Paused { Hint = "歇歇尾巴 · 按 P 继续" } else { Hint = "继续探索，前方还有收获！" }
            broadcastAndWait "pauseChanged"
            println "PAUSE", Paused, Score, PlayerX, PlayerFeet, RunTime
        }
        retryHeld = retryDown
        pauseHeld = pauseDown
        if Running && !Paused {
            RunTime += DT
            step := int(RunTime / 30)
            Speed = 58 * (1 + float64(step) * 0.04)
            if Speed > 72.5 { Speed = 72.5 }
            if step != lastSpeedStep {
                lastSpeedStep = step
                println "PACE", RunTime, Speed
            }
            dx := Speed * DT
            Distance += dx
            for i := 0; i < 5; i++ {
                PX[i] -= dx
                LX[i] -= dx
                HX[i] -= dx
            }
            for i := 0; i < 15; i++ { ItemX[i] -= dx }
            for i := 0; i < 5; i++ {
                if PX[i] + PW[i] / 2 < -305 {
                    right := -305.0
                    for j := 0; j < 5; j++ {
                        if PX[j] + PW[j] / 2 > right { right = PX[j] + PW[j] / 2 }
                    }
                    makeChunk i, right, false
                }
            }
            broadcastAndWait "physics"
            broadcastAndWait "render"
            if RunTime > feedbackUntil && Running {
                Hint = "A/D 移动 · 空格跳跃 · 蘑菇+1 / 水晶+3"
            }
        }
        // The character stays ahead of scenery, ledges, pickups and hazards.
        Lita.setLayer Front
        wait 0.016
    }
}
