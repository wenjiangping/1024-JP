// Bomb2 is idle until body contact; lock the run before a single animation.
var (
    Slot int
    exploded bool
)
onStart => { hide }
onMsg "clear", => {
    if isCloned {
        stopAnimation "动画2"
        hide
        die
    }
}
onMsg "setup", => {
    if !isCloned {
        hide
        for i := 0; i < 10; i++ { Slot = i; clone }
    }
}
onCloned => { exploded = false; setCostume "默认" }
onMsg "danger", => {
    if isCloned && OKind[Slot] == 5 && !exploded && Running && !Paused {
        if BodyX+9 > OX[Slot]-OW[Slot] && BodyX-9 < OX[Slot]+OW[Slot] && PlayerFeet < OY[Slot]+OH[Slot] && PlayerFeet+43 > OY[Slot]+3 {
            exploded = true
            finishRun "碰到炸弹了"
            play "烟花声"
            animate "动画2"
            println "BOOM", Slot, epoch
        }
    }
}
onMsg "render", => {
    if isCloned {
        if exploded { return }
        setSize 0.4
        setXYpos OX[Slot], OY[Slot]+22.6
        if OKind[Slot] == 5 && OX[Slot] > -300 && OX[Slot] < 300 {
            if !exploded { setCostume "默认" }
            show
        } else { hide }
    }
}
