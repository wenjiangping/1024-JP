// Original orange digits, rendered only from the frozen settlement snapshot.
var Slot int
onStart => { hide }
onMsg "clear", => { if isCloned { die } }
onMsg "setup", => {
    if !isCloned {
        hide
        for i := 0; i < 8; i++ { Slot = i; clone }
    }
}
onMsg "uiTick", => {
    if !isCloned { return }
    if Screen != 3 { hide; return }
    n := FinalScore
    count := 1
    for n >= 10 { n /= 10; count++ }
    if Slot >= count { hide; return }
    n = FinalScore
    for i := 0; i < Slot; i++ { n /= 10 }
    setCostume n % 10
    digitStep := 30.0
    if count > 4 { digitStep = 120.0 / float64(count) }
    setSize digitStep / 50
    setXYpos -66 + (float64(count-1)/2-float64(Slot))*digitStep, -59
    show
}
// The result panel is raised after uiTick; raise every digit after that panel.
onMsg "scoreFront", => { if isCloned && Screen == 3 { setLayer Front } }
