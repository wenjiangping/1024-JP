// Clone slots display the current score, including zero, in HUD or settlement.
var (
    Slot int
    rendered [8]bool
    renderedScreen int
    renderedScore int
)
onStart => { hide; renderedScreen = -1; renderedScore = -1 }
onMsg "clear", => { if isCloned { die } }
onMsg "setup", => {
    if !isCloned { hide; for i := 0; i < 8; i++ { Slot = i; clone } }
}
onMsg "uiTick", => {
    if !isCloned { return }
    // Settlement digits are a snapshot. Once rendered, leave the clones
    // untouched so the runner does not redraw/reorder them every frame.
    if Screen == 3 && renderedScreen == 3 && renderedScore == Score && rendered[Slot] {
        return
    }
    if renderedScreen != Screen || renderedScore != Score {
        for i := 0; i < 8; i++ { rendered[i] = false }
        renderedScreen = Screen
        renderedScore = Score
    }
    n := Score
    count := 1
    for n >= 10 { n /= 10; count++ }
    if Screen == 3 && rendered[Slot] { return }
    if Screen == 0 || Slot >= count { hide; rendered[Slot] = true; return }
    n = Score
    for i := 0; i < Slot; i++ { n /= 10 }
    setCostume n % 10
    if Screen == 3 {
        setSize 0.6
        setXYpos -66 + (float64(count-1)/2-float64(Slot))*30, -59
    } else {
        setSize 0.2
        setXYpos -155 + (float64(count-1)/2-float64(Slot))*9, 162
    }
    show
    setLayer Front
    rendered[Slot] = true
}
onMsg "scoreFront", => { if isCloned { setLayer Front } }
onMsg "scoreFront", => { if isCloned { setLayer Front } }
