// Solid obstacle 2: never ends a run on touch. Geometry is in OW/OH.
var Slot int
onStart => { hide }
onMsg "clear", => { if isCloned { die } }
onMsg "setup", => {
    if !isCloned {
        hide
        for i := 0; i < 10; i++ { Slot = i; clone }
    }
}
onMsg "render", => {
    if isCloned {
        setSize 0.18
        setXYpos OX[Slot], OY[Slot] + 15.84
        if OKind[Slot] == 2 && OX[Slot] > -290 && OX[Slot] < 290 { show } else { hide }
    }
}
