// The button owns its pointer input; it never triggers a play-area jump.
var held bool
onMsg "setup", => { held = true; setXYpos 201, -153; setLayer Front; show }
onMsg "input", => {
    pressed := mousePressed && mouseX > 178 && mouseX < 224 && mouseY > -176 && mouseY < -130
    UIJump = pressed
    held = pressed
}

// Event input preserves quick taps between frame polls.
onClick => { broadcast "requestJump" }

onMsg "pointerTap", => {
    if mouseX > 178 && mouseX < 224 && mouseY > -176 && mouseY < -130 { broadcast "requestJump" }
}
