// User-supplied green control, with pointer bounds matching its visible 42px box.
var held bool
onMsg "setup", => { held = true }
onMsg "uiTick", => {
    setXYpos 212, -156
    setSize 0.21
    if Screen == 2 { show; setLayer Front } else { hide }
}
onMsg "input", => {
    UIJump = Screen == 2 && InputReady && !Paused && mousePressed && mouseX > 191 && mouseX < 233 && mouseY > -177 && mouseY < -135
}
onClick => { if Screen == 2 && InputReady && !Paused { broadcast "requestJump" } }
