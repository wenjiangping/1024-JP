// User-supplied green control, with pointer bounds matching its visible 42px box.
var held bool
onMsg "setup", => { held = true }
onMsg "uiTick", => {
    setXYpos 65, -156
    if Paused { setCostume "继续" } else { setCostume "默认" }
    setSize 0.21
    if Screen == 2 { show; setLayer Front } else { hide }
}
onMsg "input", => {
    down := Screen == 2 && mousePressed && mouseX > 44 && mouseX < 86 && mouseY > -177 && mouseY < -135
    if down && !held { WantsPause = true }
    held = down
}
onClick => { if Screen == 2 && !held { WantsPause = true; held = true } }
